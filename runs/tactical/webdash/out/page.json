eturn tr; });\n  }\n  document.querySelectorAll('.nt-table').forEach(t => t.querySelectorAll('th').forEach(th => th.addEventListener('click', () => {\n    const k = th.dataset.field, cur = t._sort; t._sort = { k, dir: cur && cur.k === k && cur.dir === 'ascending' ? 'descending' : 'ascending' };\n    t.querySelectorAll('th').forEach(h => h.removeAttribute('aria-sort')); th.setAttribute('aria-sort', t._sort.dir); drawTables();\n  })));\n  document.getElementById('q-journal').addEventListener('input', (e) => { document.getElementById('t-journal')._q = e.target.value; drawTables(); });\n\n  dash.onData(() => { fillText(); drawVerdicts(); drawModels(); drawLong(); drawDev(); drawFinal(); drawTables(); });\n  const named = document.getElementById(location.hash.slice(1)); if (named) { named.scrollIntoView(); dash.setLink(named.id); }\n})();\n</script>\n"}